# Copiar como backend/.env y completar los valores.

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=sigecue.uho.edu.cu

# Cifrado de datos personales (RG-025). Generar cada una con:
#   python manage.py generar_clave
# Si se pierde FIELD_ENCRYPTION_KEY, los datos cifrados no se pueden recuperar.
FIELD_ENCRYPTION_KEY=
SEARCH_HASH_KEY=

# PostgreSQL (solo producción)
POSTGRES_DB=sigecue
POSTGRES_USER=sigecue
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Archivos subidos (fuera del directorio web público)
MEDIA_ROOT=/var/lib/sigecue/media

# Celery + Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# En desarrollo sin Redis: True ejecuta las tareas en el mismo proceso
CELERY_TASK_ALWAYS_EAGER=True

API_PAGE_SIZE=20
