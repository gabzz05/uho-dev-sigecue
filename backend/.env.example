# Copiar como backend/.env y completar los valores.

# Django
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=sigecue.uho.edu.cu

# Cifrado de datos personales (RG-025). Generar cada una con:
#   python manage.py generar_clave
# Si se pierde FIELD_ENCRYPTION_KEY, los datos cifrados no se pueden recuperar.
FIELD_ENCRYPTION_KEY=
SEARCH_HASH_KEY=

# PostgreSQL (solo producción)
POSTGRES_DB=sigecue
POSTGRES_USER=sigecue
POSTGRES_PASSWORD=cambiar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Archivos subidos (fuera del directorio web público)
MEDIA_ROOT=/var/lib/sigecue/media
# Imágenes públicas (carreras, facultades, CUM/FUM), servidas por nginx en /media/
PUBLIC_MEDIA_ROOT=/var/lib/sigecue/media_publica

# Celery + Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# En desarrollo sin Redis: True ejecuta las tareas en el mismo proceso
CELERY_TASK_ALWAYS_EAGER=True

API_PAGE_SIZE=20

# URL pública del frontend (enlaces de activación en los correos)
FRONTEND_URL=https://sigecue.uho.edu.cu

# Autenticación
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=15
AUTH_THROTTLE_RATE=60/min
INTERES_THROTTLE_RATE=10/hour
RESULTADOS_THROTTLE_RATE=10/hour
# Solo False si se sirve sin HTTPS (no recomendado fuera de desarrollo)
AUTH_COOKIE_SECURE=True
# Ruta Python de la integración con auth.uho.edu.cu (ver docs/SGU.md). Vacío = desactivada.
SGU_PROVEEDOR=

# Correo saliente (SMTP corporativo)
EMAIL_HOST=smtp.uho.edu.cu
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SIGECUE <no-responder@uho.edu.cu>
