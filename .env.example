# Configuración de SIGECUE con Docker Compose. Copiar como .env y completar.
#
# 1. Claves: generarlas con
#      docker compose run --rm --no-deps backend claves
#    y pegar aquí las tres líneas. GUARDAR FIELD_ENCRYPTION_KEY Y SEARCH_HASH_KEY
#    FUERA DEL SERVIDOR: si se pierden, CI, correo y celular no se recuperan.
DJANGO_SECRET_KEY=
FIELD_ENCRYPTION_KEY=
SEARCH_HASH_KEY=

# 2. Dominio y URL pública (para probar en la propia máquina: localhost).
DJANGO_ALLOWED_HOSTS=localhost,sigecue.uho.edu.cu
FRONTEND_URL=https://localhost
SERVER_NAME=localhost
# Puertos publicados por nginx (cambiarlos si 80/443 están ocupados).
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# 3. Base de datos (el servicio `db` la crea la primera vez).
POSTGRES_DB=sigecue
POSTGRES_USER=sigecue
POSTGRES_PASSWORD=cambiar-por-una-contrasena-segura

# 4. Superadmin inicial (se crea al primer arranque si no existe; luego se puede borrar de aquí).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=cambiar-por-una-contrasena-segura

# 5. Correo saliente (también se configura en el panel: Configuración → Correo).
EMAIL_HOST=smtp.uho.edu.cu
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SIGECUE <no-responder@uho.edu.cu>

# Opcionales (valores por defecto entre paréntesis).
# LOGIN_MAX_INTENTOS=5
# LOGIN_BLOQUEO_MINUTOS=15
# AUTH_THROTTLE_RATE=20/min
# INTERES_THROTTLE_RATE=10/hour
# RESULTADOS_THROTTLE_RATE=10/hour
# API_PAGE_SIZE=20
# SGU_PROVEEDOR=        (integración con auth.uho.edu.cu, ver docs/SGU.md)
